<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:SupplyPlanner.Desktop" x:Class="SupplyPlanner.Desktop.MainWindow" Title="Планировщик поставок · SupplyPlanner" Width="1320" Height="900" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="5"><TextBlock Text="Планирование поставок" FontSize="26" FontWeight="Bold" /><TextBlock Text="{Binding ModelInfo}" Classes="muted" /></StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="580">
        <Button Content="Открыть…" Click="OpenClick" Margin="4" ToolTip.Tip="Cmd/Ctrl+O · JSON-сценарий или файл проекта" />
        <Button Content="Сохранить…" Click="SaveClick" Margin="4" ToolTip.Tip="Cmd/Ctrl+S · состояние, журнал и параметры" />
        <Button Content="Excel…" Click="ExportClick" Margin="4" />
        <Button Content="Тема" Click="ThemeClick" Margin="4" /><Button Content="Справка · F1" Click="HelpClick" Margin="4" />
      </WrapPanel>
    </Grid>
    <Border Grid.Row="1" Classes="panel" Classes.error="{Binding IsError}" Padding="12"><StackPanel Spacing="4"><TextBlock Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Text="{Binding DraftNotice}" Classes="muted" FontSize="12" /></StackPanel></Border>
    <Grid Grid.Row="2" ColumnDefinitions="250,*" ColumnSpacing="18">
      <Border Classes="panel" Padding="18,18,6,18"><ScrollViewer x:Name="ParametersScroll" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="9" Margin="0,0,24,0">
        <TextBlock Text="Параметры плана" Classes="section" Margin="0,0,0,8" />
        <TextBlock Text="Название сценария" Classes="muted" /><TextBox x:Name="ScenarioNameInput" Text="{Binding Name}" />
        <TextBlock Text="Метод прогноза" Classes="muted" /><ComboBox x:Name="ForecastStrategySelect" ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}" />
        <TextBlock Text="Доставка, дней" Classes="muted" /><TextBox Text="{Binding Lead}" />
        <TextBlock Text="Запас после прибытия, дней" Classes="muted" /><TextBox Text="{Binding Target}" />
        <TextBlock Text="Страховой запас, дней" Classes="muted" /><TextBox Text="{Binding Safety}" />
        <TextBlock Text="Упаковка, шт." Classes="muted" /><TextBox Text="{Binding Pack}" />
        <TextBlock Text="История спроса, дней" Classes="muted" /><TextBox Text="{Binding History}" />
        <Button Content="Рассчитать →" Classes="accent" Click="CalculateClick" Command="{Binding CalculateCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,10,0,0" />
        <TextBlock Text="Все изменения исходных данных применяются вместе при расчёте. Поступления приходят в начале дня, расход списывается в конце." Classes="muted" Margin="0,8" />
        <Button Content="Восстановить пример…" Click="ExampleClick" />
      </StackPanel></ScrollViewer></Border>
      <TabControl Grid.Column="1" x:Name="Tabs">
        <TabItem Header="План">
          <ScrollViewer x:Name="PlanScroll" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Margin="0,12,0,0">
            <Border Classes="panel"><StackPanel Spacing="8"><TextBlock Text="{Binding Summary}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding WarehouseSummary}" Foreground="#7298FF" TextWrapping="Wrap" /></StackPanel></Border>
            <WrapPanel>
              <TextBox x:Name="PlanSearch" Width="230" Watermark="Название, артикул или склад" Text="{Binding Search}" Margin="0,0,8,8" />
              <ComboBox x:Name="WarehouseFilter" Width="150" ItemsSource="{Binding Warehouses}" SelectedItem="{Binding Warehouse}" Margin="0,0,8,8" />
              <ComboBox Width="155" ItemsSource="{Binding Statuses}" SelectedItem="{Binding StatusChoice}" Margin="0,0,8,8" />
              <ComboBox Width="170" ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" Margin="0,0,8,8" />
              <Button Content="Сбросить" Command="{Binding ResetFiltersCommand}" />
            </WrapPanel>
            <DataGrid x:Name="PlanGrid" Height="310" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Товар" Width="200"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="10,4" ToolTip.Tip="{Binding Name}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Артикул" Binding="{Binding Article}" Width="95" /><DataGridTextColumn Header="Склад" Binding="{Binding Warehouse}" Width="110" /><DataGridTextColumn Header="Поставка" Binding="{Binding Quantity}" Width="95" />
                <DataGridTextColumn Header="Отправить" Binding="{Binding Dispatch}" Width="115" /><DataGridTextColumn Header="Прибытие" Binding="{Binding Arrival}" Width="110" /><DataGridTemplateColumn Header="Оценка" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="10,4" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <Border Classes="panel"><StackPanel Spacing="12">
              <TextBlock Text="{Binding DetailTitle}" Classes="section" TextWrapping="Wrap" /><TextBlock Text="{Binding DetailNote}" TextWrapping="Wrap" />
              <TextBlock Text="Синий: с новой поставкой · серый: без новой · оранжевый: страховой запас" Classes="muted" />
              <local:InventoryChart x:Name="Chart" Plan="{Binding SelectedPlan}" Height="230" Focusable="True" />
              <TextBlock Text="{Binding DayInfo}" TextWrapping="Wrap" /><TextBlock Text="Наведите курсор или выберите день клавишами ← →, Home, End." Classes="muted" FontSize="12" />
              <Expander Header="Расчёт по дням"><DataGrid Height="270" ItemsSource="{Binding Days}" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns><DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="115" /><DataGridTextColumn Header="Поступит" Binding="{Binding Incoming}" Width="90" /><DataGridTextColumn Header="Новая поставка" Binding="{Binding NewDelivery}" Width="120" /><DataGridTextColumn Header="Без новой" Binding="{Binding Baseline}" Width="100" /><DataGridTextColumn Header="С новой" Binding="{Binding Planned}" Width="100" /><DataGridTextColumn Header="Потерянный спрос" Binding="{Binding Lost}" Width="140" /></DataGrid.Columns>
              </DataGrid></Expander>
            </StackPanel></Border>
          </StackPanel></ScrollViewer>
        </TabItem>
        <TabItem Header="Исходные данные">
          <Grid RowDefinitions="Auto,*" Margin="0,14,0,0" RowSpacing="12">
            <TextBlock Text="Редактируйте остаток и спрос двойным щелчком по ячейке. Пустой остаток = неизвестно. История: целые числа через ; в порядке дат, ? = неполный день. Затем нажмите «Рассчитать»." TextWrapping="Wrap" Classes="muted" />
            <DataGrid Grid.Row="1" x:Name="SourceGrid" ItemsSource="{Binding Sources}" AutoGenerateColumns="False" CanUserSortColumns="False">
              <DataGrid.Columns><DataGridTextColumn Header="Товар" Binding="{Binding Name}" IsReadOnly="True" Width="230" /><DataGridTextColumn Header="Артикул" Binding="{Binding Article}" IsReadOnly="True" Width="110" /><DataGridTextColumn Header="Склад" Binding="{Binding Warehouse}" IsReadOnly="True" Width="115" /><DataGridTextColumn Header="Остаток" Binding="{Binding Stock, Mode=TwoWay}" Width="110" /><DataGridTextColumn Header="Даты истории" Binding="{Binding Dates}" IsReadOnly="True" Width="170" /><DataGridTextColumn Header="Спрос по дням" Binding="{Binding History, Mode=TwoWay}" Width="230" /></DataGrid.Columns>
            </DataGrid>
          </Grid>
        </TabItem>
        <TabItem Header="Поступления">
          <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="14" Margin="0,14,0,0">
            <TextBlock Text="Добавляйте только ожидаемый товар, который ещё не включён в остатки. Изменение поступления сразу пересчитывает план, включая правки исходных данных." TextWrapping="Wrap" Classes="muted" />
            <WrapPanel Grid.Row="1"><ComboBox x:Name="DeliveryProduct" ItemsSource="{Binding Sources}" Width="320" Margin="0,0,8,8"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBox x:Name="DeliveryDate" Width="130" Watermark="дд.ММ.гггг" Margin="0,0,8,8" /><TextBox x:Name="DeliveryQuantity" Width="110" Watermark="Количество" Margin="0,0,8,8" /><Button Content="Добавить" Click="AddDeliveryClick" /></WrapPanel>
            <DataGrid Grid.Row="2" x:Name="DeliveryGrid" ItemsSource="{Binding Deliveries}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Товар" Binding="{Binding Name}" Width="300" /><DataGridTextColumn Header="Склад" Binding="{Binding Warehouse}" Width="130" /><DataGridTextColumn Header="Прибытие" Binding="{Binding Date}" Width="130" /><DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="100" /><DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120" /></DataGrid.Columns></DataGrid>
            <Button Grid.Row="3" Content="Удалить выбранное поступление…" Click="RemoveDeliveryClick" HorizontalAlignment="Left" />
          </Grid>
        </TabItem>
        <TabItem Header="Журнал"><DataGrid ItemsSource="{Binding Journal}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0"><DataGrid.Columns><DataGridTextColumn Header="Время" Binding="{Binding At, StringFormat={}{0:dd.MM HH:mm:ss zzz}}" Width="200" /><DataGridTextColumn Header="Событие C#" Binding="{Binding Event}" Width="170" /><DataGridTextColumn Header="Описание" Binding="{Binding Message}" Width="*" /></DataGrid.Columns></DataGrid></TabItem>
      </TabControl>
    </Grid>
    <TextBlock Grid.Row="3" Text="Локальное приложение · C# / .NET 10 / Avalonia · без WB, чат-бота и серверов · F1 — справка" Classes="muted" FontSize="11" />
  </Grid>
</Window>
