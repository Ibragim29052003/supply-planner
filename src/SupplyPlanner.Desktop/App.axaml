<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SupplyPlanner.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Resources><ResourceDictionary><ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark"><SolidColorBrush x:Key="AppBackground">#0B1019</SolidColorBrush><SolidColorBrush x:Key="AppSurface">#121A27</SolidColorBrush><SolidColorBrush x:Key="AppBorder">#29384C</SolidColorBrush><SolidColorBrush x:Key="AppText">#E2E7EE</SolidColorBrush></ResourceDictionary>
    <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="AppBackground">#F4F7FB</SolidColorBrush><SolidColorBrush x:Key="AppSurface">#FFFFFF</SolidColorBrush><SolidColorBrush x:Key="AppBorder">#DCE4EF</SolidColorBrush><SolidColorBrush x:Key="AppText">#132238</SolidColorBrush></ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries></ResourceDictionary></Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <Style Selector="Window"><Setter Property="FontSize" Value="13" /><Setter Property="Background" Value="{DynamicResource AppBackground}" /></Style>
    <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource AppText}" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="38" /><Setter Property="Padding" Value="14,8" /><Setter Property="CornerRadius" Value="8" /></Style>
    <Style Selector="TextBox"><Setter Property="MinHeight" Value="36" /><Setter Property="CornerRadius" Value="7" /></Style>
    <Style Selector="ComboBox"><Setter Property="MinHeight" Value="36" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="TextBlock.section"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.7" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Border.panel"><Setter Property="Background" Value="{DynamicResource AppSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource AppBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="18" /></Style>
    <Style Selector="Border.panel.error"><Setter Property="BorderBrush" Value="#D36272" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="15" /><Setter Property="Padding" Value="12,10" /></Style>
    <Style Selector="DataGrid"><Setter Property="GridLinesVisibility" Value="Horizontal" /><Setter Property="RowHeight" Value="48" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource AppSurface}" /></Style>
  </Application.Styles>
</Application>
